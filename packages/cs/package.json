{
    "name": "@webtui/cs",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "description": "Counter-Strike 1.6 styled component set with WebTUI's attribute API. Vendored from ekmas/cs16.css (MIT).",
    "scripts": {
        "dev": "vite build --watch",
        "build": "rm -rf dist && vite build",
        "clean": "rm -rf dist .turbo node_modules",
        "format": "prettier --write 'src/**/*.css' 'vite.config.ts' 'README.md'",
        "format:check": "prettier --check 'src/**/*.css' 'vite.config.ts' 'README.md'",
        "prepublishOnly": "bun run build"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./dist/full.css",
        "./*": "./dist/*"
    },
    "devDependencies": {
        "vite": "^6.2.0"
    }
}
